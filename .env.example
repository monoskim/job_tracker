SERPAPI_API_KEY=your_serpapi_key
# Optional override. Use one query via JOB_QUERY, or multiple via JOB_QUERIES.
JOB_QUERY=site:boards.greenhouse.io/ ("first data" OR "founding data" OR "analytics engineer" OR "data engineer") (Snowflake OR dbt OR Airflow) -"Power BI" -"PowerBI"
JOB_QUERIES=site:boards.greenhouse.io/ ("first data" OR "founding data" OR "analytics engineer" OR "data engineer") (Snowflake OR dbt OR Airflow) -"Power BI" -"PowerBI" || site:jobs.ashbyhq.com/ ("first data" OR "founding data" OR "analytics engineer" OR "data engineer") (Snowflake OR dbt OR Airflow) -"Power BI" -"PowerBI" || site:jobs.lever.co/ ("first data" OR "founding data" OR "analytics engineer" OR "data engineer") (Snowflake OR dbt OR Airflow) -"Power BI" -"PowerBI"
JOB_REMOTE_CLAUSE=(remote OR "work from home") -hybrid -"on-site" -onsite
JOB_FIRST_HIRE_CLAUSE=("first data" OR "founding data" OR "first data hire" OR "first analytics engineer" OR "first data engineer" OR "build the data function")
JOB_NO_EXISTING_TEAM_CLAUSE=-"existing data team" -"join our data team" -"work with our data team" -"partner with the data team" -"growing data team" -"data team of" -"our team of data engineers"
JOB_SEARCH_GL=us
JOB_SEARCH_HL=en
